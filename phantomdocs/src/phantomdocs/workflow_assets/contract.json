{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
      "results-manifest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "organization",
          "request_id",
          "plan_hash",
          "results_hash",
          "kind",
          "artifacts"
        ],
        "properties": {
          "version": {
            "const": 1
          },
          "organization": {
            "$ref": "#/$defs/id"
          },
          "request_id": {
            "$ref": "#/$defs/id"
          },
          "plan_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "results_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "kind": {
            "const": "processed-document-results"
          },
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "role",
                "ref",
                "media_type",
                "sha256",
                "size",
                "derived_from"
              ],
              "properties": {
                "role": {
                  "$ref": "#/$defs/id"
                },
                "ref": {
                  "type": "string",
                  "minLength": 1
                },
                "media_type": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9.+-]+/[a-zA-Z0-9.+-]+$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "size": {
                  "type": "integer",
                  "minimum": 1
                },
                "derived_from": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "uniqueItems": true
                }
              }
            }
          }
        }
      },
      "archive-receipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "organization",
          "request_id",
          "plan_hash",
          "results_hash",
          "kind",
          "artifacts"
        ],
        "properties": {
          "version": {
            "const": 1
          },
          "organization": {
            "$ref": "#/$defs/id"
          },
          "request_id": {
            "$ref": "#/$defs/id"
          },
          "plan_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "results_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "kind": {
            "const": "archived-document-results"
          },
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "role",
                "ref",
                "archive_ref",
                "sha256",
                "size",
                "slug"
              ],
              "properties": {
                "role": {
                  "$ref": "#/$defs/id"
                },
                "ref": {
                  "type": "string",
                  "pattern": "^gdrive://[A-Za-z0-9_-]+$"
                },
                "archive_ref": {
                  "type": "string",
                  "pattern": "^gdrive://[A-Za-z0-9_-]+$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "size": {
                  "type": "integer",
                  "minimum": 1
                },
                "slug": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9.-]*$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                },
                "md5": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$"
                }
              }
            }
          }
        }
      },
    "signed-request": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "crypto_version", "kind", "job", "issued_at", "expires_at", "signer_pubkey", "signature"],
      "properties": {
        "version": {"const": 1}, "crypto_version": {"const": 1},
        "kind": {"const": "signed-document-job"}, "job": {"$ref": "#/$defs/job"},
        "issued_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "expires_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "signer_pubkey": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "signature": {"type": "string", "pattern": "^[0-9a-f]{128}$"}
      }
    },
    "id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"},
    "ids": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
    "context": {
      "type": "object", "additionalProperties": false,
      "required": ["domain", "document_type", "requesting_domain"],
      "properties": {
        "domain": {"$ref": "#/$defs/id"},
        "document_type": {"$ref": "#/$defs/id"},
        "requesting_domain": {"$ref": "#/$defs/id"}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "role", "ref", "media_type"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "role": {"$ref": "#/$defs/id"},
        "ref": {"type": "string", "minLength": 1, "maxLength": 4096},
        "media_type": {"type": "string", "pattern": "^[a-zA-Z0-9.+-]+/[a-zA-Z0-9.+-]+$"}
      }
    },
    "job": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "organization", "request_id", "requester", "context", "artifacts"],
      "properties": {
        "version": {"const": 1}, "organization": {"$ref": "#/$defs/id"},
        "request_id": {"$ref": "#/$defs/id"}, "requester": {"$ref": "#/$defs/id"},
        "context": {"$ref": "#/$defs/context"},
        "artifacts": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/artifact"}}
      }
    },
    "step": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "capability", "needs", "inputs", "outputs"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "capability": {"$ref": "#/$defs/id"},
        "needs": {"$ref": "#/$defs/ids"}, "inputs": {"$ref": "#/$defs/ids"},
        "outputs": {"$ref": "#/$defs/ids"}
      }
    },
    "protocol": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "instructions", "initial_roles", "final_roles", "steps"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "version": {"$ref": "#/$defs/id"},
        "instructions": {"type": "string", "minLength": 1},
        "initial_roles": {"$ref": "#/$defs/ids"}, "final_roles": {"$ref": "#/$defs/ids"},
        "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}}
      }
    },
    "registry": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "protocols"],
      "properties": {
        "version": {"const": 1},
        "protocols": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/protocol"}}
      }
    },
    "route": {
      "type": "object", "additionalProperties": false,
      "required": ["domain", "document_type", "protocol", "protocol_version", "folder", "owner_domains"],
      "properties": {
        "domain": {"$ref": "#/$defs/id"}, "document_type": {"$ref": "#/$defs/id"},
        "protocol": {"$ref": "#/$defs/id"}, "protocol_version": {"$ref": "#/$defs/id"},
        "folder": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*(/[a-z0-9][a-z0-9.-]*)*$"},
        "archive_ref": {"type": "string", "pattern": "^gdrive://[A-Za-z0-9_-]+$"},
        "owner_domains": {"type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(\\$requesting_domain|[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127})$"}},
        "owners": {"$ref": "#/$defs/ids"}, "branding_profile": {"$ref": "#/$defs/id"}
      }
    },
    "tool": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "entrypoint"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "version": {"$ref": "#/$defs/id"},
        "entrypoint": {"type": "string", "minLength": 1, "maxLength": 4096},
        "script": {"type": "string", "minLength": 1, "maxLength": 4096},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "script_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "arguments": {"type": "array", "items": {"type": "string"}},
        "variants": {"type": "object", "propertyNames": {"$ref": "#/$defs/id"},
          "additionalProperties": {"type": "array", "items": {"type": "string"}}}
      }
    },
    "installation": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "organization", "intake", "processor", "routes", "tools"],
      "properties": {
        "version": {"const": 1}, "organization": {"$ref": "#/$defs/id"},
        "intake": {"type": "object", "additionalProperties": false, "required": ["inbox"],
          "properties": {"inbox": {"$ref": "#/$defs/id"}}},
        "processor": {"type": "object", "additionalProperties": false,
          "required": ["source"], "properties": {"source": {"const": "phantombot-default"}}},
        "routes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/route"}},
        "tools": {"type": "object", "propertyNames": {"$ref": "#/$defs/id"},
          "additionalProperties": {"$ref": "#/$defs/tool"}}
      }
    }
  }
}
