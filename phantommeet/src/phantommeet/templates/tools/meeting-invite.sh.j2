#!/usr/bin/env bash
#
# meeting-invite.sh — create a meeting invitation for PhantomMeet.
#
# Rendered from the PhantomMeet manifest by `pm apply`: every
# installation-specific value below comes from the manifest (see the
# "Installation configuration" block). This script only creates and sends
# the *invitation notification*. It never switches personas and never
# schedules tasks in another runtime: each recipient's own runtime decides
# (from its own scheduled state) whether to join. See
# kb/procedures/Meetings.md.
#
# Usage:
#   meeting-invite.sh --title "..." --type <type> --datetime <ISO-8601> \
#       --recipients "@a,@b" [--topic <topic>] \
#       [--password-vault <name> | --password-file <path>] [--force] [--dry-run]
#
# Flags:
#   --title TEXT          Meeting title (required)
#   --type TEXT           Room type token (optional; only used if the naming
#                         convention contains a {type} slot)
#   --datetime ISO        Start time, ISO 8601 (required, e.g. 2026-08-10T17:00:00)
#   --recipients LIST     Comma-separated @mentions of the recipients (required)
#   --topic TEXT          Optional room topic token; when omitted, the {topic}
#                         slot (and its leading hyphen) is dropped from the name
#   --password-vault NAME Declare the room is password-locked (secret lives in
#                         the vault; never read or broadcast here)
#   --password-file PATH  Declare the room is password-locked (secret lives in
#                         the file; never read or broadcast here)
#   --force               Convene even when the recorder is not ready (the
#                         meeting is not recorded; see the recorder preflight)
#   --dry-run             Print everything without sending anything
#
# Recorder preflight: before sending any invitation this tool asks the bridge
# (GET /status -> recorder.ready) whether the recorder is usable. If it is not,
# the invitation is NOT sent and the responsible persona is notified via the
# configured send_via (phantombot-notify), with the reason. --force overrides
# this and convenes anyway, WITHOUT recording. --dry-run is a pure preview and
# skips the check. The bridge's admin token is read ONLY from the environment
# (PHANTOMBRIDGE_ADMIN_TOKEN) at run time, never from the manifest.
#
# Announcement card format: the manifest may define a custom card
# (invite.card) using the tokens %TITLE%, %RECIPIENTS%, %DATETIME%,
# %LINK%, %ROOM% and %PASSWORD_LINE% (expands to a "password shared
# separately" notice when the room is password-locked, or nothing when it is
# not — the secret itself is never read or broadcast). Without invite.card,
# a built-in language-aware format is used.
#
# Every message that leaves this machine goes through phantombot; this
# script only shells out to the configured binary.

set -euo pipefail

# =========================================================================
# Installation configuration (rendered from the manifest — edit per install)
# =========================================================================
# Every scalar is shell-quoted at render time (single-quoted, shlex-style),
# so a manifest value can never break out of an assignment and execute.
PHANTOMBOT_BIN={{ invite.phantombot_bin | default('phantombot') | shquote }}
PERSONA={{ name | shquote }}                      # the persona running this script
MEET_BASE_URL={{ invite.meet_base_url | default('') | shquote }}
# Bridge local HTTP API used for the recorder preflight (GET /status). The
# admin token is NOT here: it is read from PHANTOMBRIDGE_ADMIN_TOKEN at run
# time (never stored in the manifest). Override the URL per deployment with
# invite.bridge_status_url.
BRIDGE_STATUS_URL={{ invite.bridge_status_url | default('http://127.0.0.1:8090/status') | shquote }}
ROOM_NAMING={{ rooms.naming | default('{YYYY-MM-DD}-{HH-MM}_{topic}') | shquote }}
LANGUAGE={{ language | shquote }}
# Personalized announcement card (optional). Empty string = built-in format.
# Shell-quoted at render time; multi-line cards survive verbatim and cannot
# terminate the script or inject commands.
CARD_TEMPLATE={{ invite.card | default('') | shquote }}
# =========================================================================
{% raw %}
usage() {
  sed -n '2,40p' "$0" | sed 's/^# \{0,1\}//'
  exit 1
}

# --- argument parsing -----------------------------------------------------
TITLE=""
TYPE=""
DATETIME=""
RECIPIENTS=""
TOPIC=""
PASSWORD_VAULT=""
PASSWORD_FILE=""
FORCE=0
DRY_RUN=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --title) TITLE="$2"; shift 2 ;;
    --type) TYPE="$2"; shift 2 ;;
    --datetime) DATETIME="$2"; shift 2 ;;
    --recipients) RECIPIENTS="$2"; shift 2 ;;
    --topic) TOPIC="$2"; shift 2 ;;
    --password-vault) PASSWORD_VAULT="$2"; shift 2 ;;
    --password-file) PASSWORD_FILE="$2"; shift 2 ;;
    --force) FORCE=1; shift ;;
    --dry-run) DRY_RUN=1; shift ;;
    *) echo "unknown option: $1" >&2; usage ;;
  esac
done

[[ -n "$TITLE" && -n "$DATETIME" && -n "$RECIPIENTS" ]] || {
  echo "error: --title, --datetime and --recipients are required" >&2
  usage
}

# --- strict ISO-8601 validation (before any use of $DATETIME substrings) --
# YYYY-MM-DDTHH:MM:SS with an optional Z / ±HH:MM offset. Rejecting anything
# else means the substrings fed into the room name are digits and hyphens
# only — no shell/sed metacharacters can ride in through --datetime.
if [[ ! "$DATETIME" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})?$ ]]; then
  echo "error: --datetime must be strict ISO 8601 (YYYY-MM-DDTHH:MM:SS, optional Z/±HH:MM)" >&2
  exit 1
fi

# --- room password: declared, never read, never broadcast ------------------
# `phantombot notify` broadcasts to every authorized owner on every configured
# channel, so the room password must NOT travel in the invitation body. The
# --password-vault / --password-file flags only DECLARE that the room is
# password-locked (and name where the secret lives for the operator). This
# script never reads the secret and never prints it; recipients receive the
# password through a separate, targeted channel — not this broadcast.
PASSWORD_SET=0
if [[ -n "$PASSWORD_VAULT" && -n "$PASSWORD_FILE" ]]; then
  echo "error: use either --password-vault or --password-file, not both" >&2
  exit 1
fi
if [[ -n "$PASSWORD_VAULT" || -n "$PASSWORD_FILE" ]]; then
  PASSWORD_SET=1
fi

# --- resolve the phantombot binary (skipped in --dry-run) ------------------
if [[ "$DRY_RUN" -eq 0 ]]; then
  if ! command -v "$PHANTOMBOT_BIN" >/dev/null 2>&1; then
    for cand in "$HOME/.local/bin/$PHANTOMBOT_BIN" "$HOME/.local/bin/phantombot"; do
      if [[ -x "$cand" ]]; then
        PHANTOMBOT_BIN="$cand"
        break
      fi
    done
  fi
  if ! command -v "$PHANTOMBOT_BIN" >/dev/null 2>&1 && [[ "$PHANTOMBOT_BIN" != /* ]]; then
    echo "error: no se encontró el binario phantombot ($PHANTOMBOT_BIN) en PATH ni en ~/.local/bin" >&2
    exit 1
  fi
fi

# --- recorder preflight (v0) ------------------------------------------------
# Before inviting, ask the bridge whether the recorder is usable. The bridge
# owns the readiness rule (HEALTHY + IDLE) and exposes it in GET /status; this
# tool only reads `recorder.ready`. The admin token is read from the
# environment ONLY (PHANTOMBRIDGE_ADMIN_TOKEN) — never from the manifest. No
# token, an unreachable bridge, or a not-ready recorder all mean "do not
# invite"; pass --force to convene anyway, without recording. Uses python3
# (already a PhantomMeet prerequisite) for the HTTP GET + JSON parse, so no
# extra dependency (curl/jq) is introduced.
RECORDER_READY=0
RECORDER_REASON="recorder not checked"

recorder_preflight() {
  local out
  out="$(python3 - "$BRIDGE_STATUS_URL" <<'PY' 2>/dev/null
import json
import os
import sys
import urllib.error
import urllib.request

url = sys.argv[1]
token = os.environ.get("PHANTOMBRIDGE_ADMIN_TOKEN", "").strip()
if not token:
    print("ERROR PHANTOMBRIDGE_ADMIN_TOKEN is not set (the bridge /status needs its admin token)")
    raise SystemExit(0)
req = urllib.request.Request(url, headers={"Authorization": "Bearer " + token})
try:
    with urllib.request.urlopen(req, timeout=5) as resp:
        raw = resp.read().decode("utf-8", "replace")
except urllib.error.HTTPError as exc:
    print("ERROR bridge status returned HTTP %s" % exc.code)
    raise SystemExit(0)
except Exception as exc:
    print("ERROR bridge unreachable at %s: %s" % (url, exc))
    raise SystemExit(0)
try:
    data = json.loads(raw)
except Exception:
    print("ERROR unrecognized bridge status payload")
    raise SystemExit(0)
rec = data.get("recorder") if isinstance(data, dict) else None
if not isinstance(rec, dict):
    print("ERROR bridge status has no recorder field (is the bridge up to date?)")
    raise SystemExit(0)
if rec.get("ready") is True:
    print("READY")
else:
    print("NOTREADY " + str(rec.get("reason") or "recorder not ready"))
PY
)" || out=""
  case "$out" in
    READY) RECORDER_READY=1; RECORDER_REASON="recorder ready"; return 0 ;;
    NOTREADY\ *) RECORDER_REASON="${out#NOTREADY }"; return 1 ;;
    ERROR\ *) RECORDER_REASON="${out#ERROR }"; return 1 ;;
    *) RECORDER_REASON="could not verify the recorder (python3 missing, or the bridge status was unreadable)"; return 1 ;;
  esac
}

# Language-aware message sent to the responsible persona when the invitation
# is withheld (same send_via as the invitation itself: phantombot notify).
recorder_refusal_message() {
  if [[ "$LANGUAGE" == "es" ]]; then
    printf '⚠️ Reunión NO agendada: la grabadora no está disponible (%s). "%s" para %s a las %s no se ha invitado. Arregla la grabadora y vuelve a intentarlo, o usa --force para convocar sin grabación.' \
      "$RECORDER_REASON" "$TITLE" "$RECIPIENTS" "$DATETIME"
  else
    printf '⚠️ Meeting NOT scheduled: the recorder is not usable (%s). "%s" for %s at %s was not invited. Fix the recorder and retry, or use --force to convene without recording.' \
      "$RECORDER_REASON" "$TITLE" "$RECIPIENTS" "$DATETIME"
  fi
}

# --- derive the room name from the naming convention ----------------------
slug() {
  # lowercase, no accents, spaces/symbols -> underscores, strip non [a-z0-9_].
  # Fixed sed programs only: the input is piped through, never interpolated
  # into the sed expression, so no injection surface here.
  echo "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | sed 's/á/a/g; s/é/e/g; s/í/i/g; s/ó/o/g; s/ú/u/g; s/ñ/n/g; s/ü/u/g' \
    | sed 's/[^a-z0-9]\+/_/g' \
    | sed 's/^_//; s/_$//'
}

YYYY="${DATETIME:0:4}"
MM="${DATETIME:5:2}"
DD="${DATETIME:8:2}"
HH="${DATETIME:11:2}"
MIN="${DATETIME:14:2}"

# Build the room name with bash parameter expansion (no generated sed
# program). $DATETIME was already validated, and $TYPE/$TOPIC are slug()'d,
# so every substituted value is [a-z0-9_-] only.
room_name="$ROOM_NAMING"
room_name="${room_name//\{type\}/$(slug "$TYPE")}"
room_name="${room_name//\{YYYY-MM-DD\}/$YYYY-$MM-$DD}"
room_name="${room_name//\{DD-MM-YYYY\}/$DD-$MM-$YYYY}"
room_name="${room_name//\{HH-MM\}/$HH-$MIN}"
room_name="${room_name//\{YYYY\}/$YYYY}"
room_name="${room_name//\{MM\}/$MM}"
room_name="${room_name//\{DD\}/$DD}"
if [[ -n "$TOPIC" ]]; then
  room_name="${room_name//\{topic\}/$(slug "$TOPIC")}"
else
  # Drop the {topic} slot together with its leading hyphen.
  room_name="${room_name//-\{topic\}/}"
  room_name="${room_name//\{topic\}/}"
fi
# any remaining {token} collapses to 'x' (constant pattern, no user input)
room_name="$(printf '%s' "$room_name" | sed 's/{[^}]*}/x/g')"

# --- build the invitation text --------------------------------------------
# Custom card from the manifest (invite.card) wins; the built-in format is
# the fallback. Runtime values are substituted literally (%TOKEN% → value);
# blank lines are dropped so an empty %PASSWORD_LINE% leaves no hole.
if [[ -n "$CARD_TEMPLATE" ]]; then
  card_text="$CARD_TEMPLATE"
  card_text="${card_text//%TITLE%/$TITLE}"
  card_text="${card_text//%RECIPIENTS%/$RECIPIENTS}"
  card_text="${card_text//%DATETIME%/$DATETIME}"
  card_text="${card_text//%LINK%/$MEET_BASE_URL/$room_name}"
  card_text="${card_text//%ROOM%/$room_name}"
  if [[ "$PASSWORD_SET" -eq 1 ]]; then
    if [[ "$LANGUAGE" == "es" ]]; then
      card_text="${card_text//%PASSWORD_LINE%/🔒 Contraseña: se comparte por separado}"
    else
      card_text="${card_text//%PASSWORD_LINE%/🔒 Password: shared separately}"
    fi
  else
    card_text="${card_text//%PASSWORD_LINE%/}"
  fi
  card_text="$(printf '%s\n' "$card_text" | sed '/^[[:space:]]*$/d')"
  invite_text="$card_text"
else
  if [[ "$LANGUAGE" == "es" ]]; then
    INVITE_HEADER="📅 Reunión: ${TITLE}"
    INVITE_RECIPIENTS="👥 Destinatarios: ${RECIPIENTS}"
    INVITE_TIME="🕐 ${DATETIME}"
    INVITE_LINK="🔗 ${MEET_BASE_URL}/${room_name}"
    if [[ "$PASSWORD_SET" -eq 1 ]]; then
      INVITE_PASSWORD="🔒 Contraseña: se comparte por separado"
    fi
  else
    INVITE_HEADER="📅 Meeting: ${TITLE}"
    INVITE_RECIPIENTS="👥 Recipients: ${RECIPIENTS}"
    INVITE_TIME="🕐 ${DATETIME}"
    INVITE_LINK="🔗 ${MEET_BASE_URL}/${room_name}"
    if [[ "$PASSWORD_SET" -eq 1 ]]; then
      INVITE_PASSWORD="🔒 Password: shared separately"
    fi
  fi

  invite_text="${INVITE_HEADER}
${INVITE_RECIPIENTS}
${INVITE_TIME}
${INVITE_LINK}"
  [[ -n "${INVITE_PASSWORD:-}" ]] && invite_text="${invite_text}
${INVITE_PASSWORD}"
fi

# --- recorder preflight: never invite while the recorder is unusable --------
# If the recorder is not ready the invitation is withheld and the responsible
# persona is notified; --force convenes anyway, without recording. --dry-run is
# a pure preview (no network, no side effects) and therefore never gates.
if [[ "$DRY_RUN" -eq 0 ]]; then
  recorder_preflight || {
    if [[ "$FORCE" -eq 1 ]]; then
      echo "warning: recorder not ready — ${RECORDER_REASON}; --force given: convening WITHOUT recording" >&2
    else
      echo "error: recorder not ready — ${RECORDER_REASON}" >&2
      if "${PHANTOMBOT_BIN}" notify --message "$(recorder_refusal_message)" --persona "${PERSONA}"; then
        echo "invitation NOT sent: recorder not ready (notified the responsible persona)"
      else
        echo "warning: could not notify the responsible persona about the recorder" >&2
        echo "invitation NOT sent: recorder not ready"
      fi
      exit 1
    fi
  }
fi

# --- send the invitation as a notification only ---------------------------
# No cross-persona scheduling and no persona switch happen here. Each
# recipient's own runtime decides, from its own scheduled state, whether to
# join — the invitation text is informational, never an authorization.
# `phantombot notify` broadcasts to every authorized owner on every
# configured channel; there is no targeted per-chat delivery interface.
if [[ "$DRY_RUN" -eq 1 ]]; then
  echo "[dry-run] would notify: ${PHANTOMBOT_BIN} notify --message \"${invite_text}\" --persona ${PERSONA}"
else
  "${PHANTOMBOT_BIN}" notify --message "${invite_text}" --persona "${PERSONA}"
  echo "invitation broadcast via phantombot notify"
fi

# --- summary ----------------------------------------------------------------
# The invitation body never contains the room password (it is declared, never
# read, and never broadcast), so it is safe to echo verbatim.
echo "---"
echo "room       : ${room_name}"
if [[ "$DRY_RUN" -eq 1 ]]; then
  echo "recorder   : not checked (--dry-run)"
elif [[ "$RECORDER_READY" -eq 1 ]]; then
  echo "recorder   : ready"
else
  echo "recorder   : not ready (${RECORDER_REASON})"
fi
echo "invite     :"
echo "${invite_text}"
exit 0
{% endraw %}
