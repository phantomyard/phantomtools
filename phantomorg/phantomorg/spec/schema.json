{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PhantomOrg org.yaml",
  "type": "object",
  "required": [
    "version",
    "organization",
    "departments",
    "roles",
    "actors",
    "policies",
    "escalation_matrix",
    "communication"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "organization": {
      "type": "object",
      "required": [
        "id",
        "name",
        "sector",
        "languages"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "name": {
          "type": "string"
        },
        "sector": {
          "type": "string"
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "default_language": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "departments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "parent",
          "access_policy"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "name": {
            "type": "string"
          },
          "parent": {
            "type": [
              "string",
              "null"
            ]
          },
          "access_policy": {
            "type": "string"
          }
        }
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "department",
          "reports_to",
          "access_level"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "name": {
            "type": "string"
          },
          "department": {
            "type": "string"
          },
          "reports_to": {
            "type": [
              "string",
              "null"
            ]
          },
          "reports_to_human": {
            "type": [
              "string",
              "null"
            ]
          },
          "functions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "access_level": {
            "type": "string"
          },
          "security_exceptions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "soul_line_budget": {
            "type": "integer",
            "minimum": 50,
            "default": 300
          },
          "description": {
            "type": "string",
            "description": "Qué gestiona este rol / cuándo contactarlo. Se usa en la norma de comunicación compilada (kb/normas/comunicacion-agentes.md)."
          }
        }
      }
    },
    "actors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "role",
          "tools"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "role": {
            "type": "string"
          },
          "telegram_bot": {
            "type": "string"
          },
          "npub": {
            "type": "string",
            "pattern": "^npub1[qpzry9x8gf2tvdw0s3jn54khce6mua7l]{58}$"
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tools_excluded": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "actor_exceptions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tone": {
            "type": "string"
          },
          "email": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
          }
        }
      }
    },
    "policies": {
      "type": "object",
      "required": [
        "access_levels",
        "security_categories"
      ],
      "additionalProperties": false,
      "properties": {
        "access_levels": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "label",
              "categories"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "categories": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              }
            }
          },
          "propertyNames": {
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          }
        },
        "security_categories": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "label"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "scope": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "actor",
                  "role",
                  "org",
                  "project"
                ]
              },
              "owner": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "propertyNames": {
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          }
        }
      }
    },
    "escalation_matrix": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "condition"
        ],
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "condition": {
            "type": "string"
          },
          "cross_department": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "communication": {
      "type": "object",
      "required": [
        "request_id_format",
        "message_types",
        "max_hops"
      ],
      "additionalProperties": false,
      "properties": {
        "request_id_format": {
          "type": "string"
        },
        "message_types": {
          "type": "array",
          "items": {
            "enum": [
              "REQUEST",
              "INFORM",
              "ESCALATE",
              "CONFIRM",
              "REJECT"
            ]
          }
        },
        "max_hops": {
          "type": "integer",
          "minimum": 1,
          "default": 3
        },
        "norm_version": {
          "type": "string",
          "default": "1.0"
        },
        "envelope": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "marker": {
              "type": "string",
              "const": "[env]",
              "default": "[env]"
            },
            "ttl_hours": {
              "type": "integer",
              "minimum": 1,
              "default": 6
            }
          }
        },
        "channels": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "human": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "platform": {
                  "type": "string"
                },
                "group": {
                  "type": "string"
                },
                "chat_id": {
                  "type": "string"
                }
              },
              "required": [
                "platform"
              ]
            },
            "agent": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "platform": {
                  "type": "string"
                },
                "relay": {
                  "type": "string"
                },
                "bridge_npub": {
                  "type": "string"
                },
                "human_npubs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "principal_npubs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "public_relays": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "platform"
              ]
            }
          }
        }
      }
    },
    "humans": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "telegram_user_id": {
            "type": [
              "integer",
              "null"
            ]
          },
          "npub": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^npub1[qpzry9x8gf2tvdw0s3jn54khce6mua7l]{58}$"
          },
          "email": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
          }
        }
      }
    },
    "documents": {
      "type": "object",
      "description": "Opaque PhantomDocs namespace block (owned by phantomdocs, tolerated by PhantomOrg)"
    }
  }
}