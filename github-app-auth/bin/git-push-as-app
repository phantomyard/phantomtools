#!/usr/bin/env python3
"""
Push commits via GitHub API using the GitHub App identity.
Fallback for when HTTPS push is refused (ghs_* tokens normally work over
HTTPS as x-access-token; the git wrapper tries that first).

NOTE: this re-creates commits through the REST API. Every field is copied
byte-for-byte (message included, trailing newline and all), so an unsigned
commit whose parents don't change keeps its original SHA. A SHA still moves
when the commit was signed (the API cannot carry a signature) or when the
push replants commits onto a different parent (force push, squashed upstream).
Usage: git-push-as-app [remote] [branch]  (defaults to origin HEAD)
       git-push-as-app --guard-check ...  check-only: may this force push go
                                          ahead? Touches nothing; exits 0
                                          allowed / 1 refused / 2 undecidable.
                                          Used by the git wrapper before it
                                          pushes over HTTPS, so the
                                          default-branch guard applies to that
                                          route too.
"""

import subprocess
import sys
import os
import urllib.error
from ghapplib import (get_real_git, run_git, ensure_token, GitHubAppClient,
                      parse_owner_repo, select_unmerged_commits,
                      commit_message, is_force_arg, push_refspec_dst,
                      push_targets_every_branch, force_push_to_default_blocked)

GIT = get_real_git(__file__)
if not GIT:
    print("Error: could not locate real git binary (set GITHUB_APP_REAL_GIT)",
          file=sys.stderr)
    sys.exit(1)


def refusal(owner, repo, default_branch):
    return (f"Error: refusing to force-push to the default branch "
            f"'{default_branch}' of {owner}/{repo}. This rewrites shared "
            f"history and can drop commits other people pushed. Open a PR "
            f"from a feature branch, or rebase onto the current "
            f"{default_branch} so the push fast-forwards. To override "
            f"deliberately: GITHUB_APP_ALLOW_FORCE_DEFAULT=1 git push --force ...")


def guard_check_exit(remote, branch, args):
    """Answer "may this force push proceed?" without touching the remote.

    Return code is the whole contract: 0 allowed, 1 refused, 2 undecidable.
    The `git` wrapper aborts on anything non-zero, so an undecidable answer
    fails closed — a force push is destructive and rare enough that refusing
    on a broken token or an unreachable API beats guessing. The override env
    var is honoured first, which also keeps it usable when the API is down.
    """
    if os.environ.get("GITHUB_APP_ALLOW_FORCE_DEFAULT"):
        return 0

    try:
        repo_url = run_git(GIT, ["remote", "get-url", remote]).stdout.strip()
    except subprocess.CalledProcessError:
        return 0  # no such remote: let git report it in its own words
    parsed = parse_owner_repo(repo_url)
    if not parsed:
        return 0  # not a GitHub remote, not ours to guard
    owner, repo = parsed

    token = ensure_token()
    if not token:
        print("Error: refusing a force push — GITHUB_TOKEN is not set, so the "
              "default branch cannot be checked. Set GITHUB_APP_ALLOW_FORCE_DEFAULT=1 "
              "if you are sure.", file=sys.stderr)
        return 2

    client = GitHubAppClient(owner, repo, token, GIT)
    try:
        default_branch = client.get_default_branch()
    except Exception as e:
        print(f"Error: refusing a force push — could not read the default branch "
              f"of {owner}/{repo} ({e}). Set GITHUB_APP_ALLOW_FORCE_DEFAULT=1 if "
              f"you are sure.", file=sys.stderr)
        return 2

    target = (default_branch if push_targets_every_branch(args)
              else push_refspec_dst(branch))
    if force_push_to_default_blocked(target, default_branch, True, False):
        print(refusal(owner, repo, default_branch), file=sys.stderr)
        return 1
    return 0


def drop_already_merged(git, client, remote, commits, parent_for_first,
                        preserve_parents):
    """Filter commits already integrated on the remote default branch.

    The `--not --remotes` fallback picks commits by SHA reachability, which
    can't see squash/rebase merges (they rewrote our commits into new SHAs
    upstream). Detect those by tree-equality (squash) and patch-id (rebase)
    against the default branch; when we drop any, replant the survivors onto the
    live default-branch tip so they land on top of the merged history instead of
    resurrecting duplicates.

    Returns (commits, parent_for_first, preserve_parents). On any missing
    prerequisite (default branch not fetched locally, non-linear range, git
    error) it returns the inputs unchanged — conservative: never drop work we
    can't prove is already merged.
    """
    if not commits:
        return commits, parent_for_first, preserve_parents

    try:
        default_branch = client.get_default_branch()
    except Exception:
        return commits, parent_for_first, preserve_parents

    try:
        default_tip = run_git(
            git, ["rev-parse", "--verify", f"{remote}/{default_branch}"]
        ).stdout.strip()
    except subprocess.CalledProcessError:
        # Default branch not known locally — can't compare, leave untouched.
        return commits, parent_for_first, preserve_parents

    # A merge commit in the pushed range breaks the "deepest tree match ⇒
    # merged prefix" guarantee, so skip dedup entirely rather than risk work.
    linear = True
    for c in commits:
        parents = run_git(git, ["log", "-1", "--format=%P", c]).stdout.split()
        if len(parents) > 1:
            linear = False
            break
    if not linear:
        return commits, parent_for_first, preserve_parents

    # Trees introduced on the default branch since we diverged.
    try:
        base = run_git(git, ["merge-base", default_tip, commits[-1]]).stdout.strip()
    except subprocess.CalledProcessError:
        base = ""
    merged_range = f"{base}..{default_tip}" if base else default_tip
    merged_trees = set()
    for c in run_git(git, ["rev-list", merged_range]).stdout.split():
        merged_trees.add(
            run_git(git, ["rev-parse", f"{c}^{{tree}}"]).stdout.strip()
        )

    tree_of = {
        c: run_git(git, ["rev-parse", f"{c}^{{tree}}"]).stdout.strip()
        for c in commits
    }

    # `git cherry <upstream> <head>` marks '-' the head commits whose patch-id
    # already exists upstream — catches rebase / ordinary merges.
    patch_dup = set()
    try:
        for line in run_git(git, ["cherry", default_tip, commits[-1]]).stdout.splitlines():
            line = line.strip()
            if line.startswith("- "):
                patch_dup.add(line[2:].strip())
    except subprocess.CalledProcessError:
        pass

    survivors = select_unmerged_commits(
        commits, tree_of, merged_trees, patch_dup, linear=linear
    )
    if survivors == commits:
        return commits, parent_for_first, preserve_parents

    dropped = len(commits) - len(survivors)
    print(f"Skipping {dropped} commit(s) already merged into '{default_branch}' "
          f"(squash/rebase); replanting {len(survivors)} onto {default_tip[:7]}")
    return survivors, default_tip, False

def main():
    args = sys.argv[1:]

    if "-h" in args or "--help" in args:
        print(__doc__.strip())
        return

    # Parse flags and positional args
    force = False
    dry_run = False
    guard_check = False
    remote = None
    branch = None

    i = 0
    while i < len(args):
        a = args[i]
        if is_force_arg(a):
            force = True
            if not a.startswith("-") and remote is not None and branch is None:
                branch = a          # a '+refspec' positional, not a flag
        elif a == "--dry-run":
            dry_run = True
        elif a == "--guard-check":
            guard_check = True
        elif a.startswith("-"):
            pass  # ignore unknown flags
        elif remote is None:
            remote = a
        elif branch is None:
            branch = a
        i += 1

    remote = remote or "origin"
    branch = branch or run_git(GIT, ["rev-parse", "--abbrev-ref", "HEAD"]).stdout.strip()

    if guard_check:
        # Check-only mode, used by the `git` wrapper before it hands a force
        # push to plain git over HTTPS. That route never reaches the code
        # below, so without this the default-branch guard simply would not run.
        # Touches nothing: one read-only GET for the default branch, then exit
        # 0 (allowed) or 1 (refused). The caller only invokes it for pushes it
        # already classified as history-rewriting, so force is a given here.
        sys.exit(guard_check_exit(remote, branch, args))

    if dry_run:
        print(f"[dry-run] Would push {branch} to {remote}")
        return

    repo_url = run_git(GIT, ["remote", "get-url", remote]).stdout.strip()

    parsed = parse_owner_repo(repo_url)
    if not parsed:
        print(f"Error: could not parse owner/repo from: {repo_url}", file=sys.stderr)
        sys.exit(1)
    owner, repo = parsed

    token = ensure_token()
    if not token:
        print("Error: GITHUB_TOKEN not set", file=sys.stderr)
        sys.exit(1)

    client = GitHubAppClient(owner, repo, token, GIT)
    print(f"Pushing {branch} to {owner}/{repo} via GitHub API (App identity)...")

    # Get remote SHA
    remote_sha = ""
    branch_exists_remote = False
    try:
        # A brand-new branch legitimately 404s here — that is how we detect it.
        ref_data = client.api_request("GET", f"git/refs/heads/{branch}",
                                      quiet_codes=(404,))
        remote_sha = ref_data.get("object", {}).get("sha", "")
        branch_exists_remote = bool(remote_sha)
    except urllib.error.HTTPError as e:
        if e.code != 404:
            raise

    # Previous App-pushes upload commits via the API, which recreates commit
    # objects with new SHAs that do NOT exist in the local repo.
    remote_known_locally = False
    if remote_sha:
        try:
            run_git(GIT, ["cat-file", "-e", remote_sha])
            remote_known_locally = True
        except subprocess.CalledProcessError:
            pass

    local_sha = run_git(GIT, ["rev-parse", branch]).stdout.strip()

    if remote_sha == local_sha and remote_sha:
        print("Everything up-to-date")
        return

    is_ancestor = False
    if remote_known_locally:
        try:
            run_git(GIT, ["merge-base", "--is-ancestor", remote_sha, local_sha])
            is_ancestor = True
        except subprocess.CalledProcessError:
            pass

    from ghapplib import determine_push_strategy
    commits, parent_for_first, needs_force, preserve_parents = determine_push_strategy(
        local_sha, remote_sha, remote_known_locally, is_ancestor, branch_exists_remote, force
    )

    # Guard: never rewrite history on the repo's DEFAULT branch. A force push
    # (explicit -f, or a divergent push that needs_force) there silently drops
    # commits — exactly the rebase+force that wiped a collaborator's work. The
    # default branch is read live from the repo API, so this holds whatever it
    # is named (main, master, trunk, develop, ...). Non-force fast-forwards and
    # the recreated-SHA re-sync (needs_force=False) pass through untouched, so
    # we stay narrow and don't get "too eager". Deliberate override:
    # GITHUB_APP_ALLOW_FORCE_DEFAULT=1.
    override = bool(os.environ.get("GITHUB_APP_ALLOW_FORCE_DEFAULT"))
    if (force or needs_force) and not override:
        default_branch = client.get_default_branch()
        target = (default_branch if push_targets_every_branch(args)
                  else push_refspec_dst(branch))
        if force_push_to_default_blocked(target, default_branch, force,
                                         needs_force, override):
            print(refusal(owner, repo, default_branch), file=sys.stderr)
            sys.exit(1)

    if commits is None:
        if remote_known_locally:
            # Remote tip is a real local object (fast-forward / divergent):
            # rev-list between the known remote tip and local. Guarding on
            # remote_known_locally (not just `remote_sha`) keeps us from feeding
            # `git rev-list` a SHA it doesn't have — e.g. a force push to a
            # branch whose remote tip was recreated by an earlier App-push.
            rev_args = ["rev-list", "--topo-order", "--reverse",
                        f"{remote_sha}..{local_sha}"]
        else:
            # New branch, or a push whose remote tip isn't known locally:
            # rev-list every commit not yet on the remote. We scope to
            # refs/remotes/<remote>/* so parents resolve to SHAs the GitHub API
            # will accept as branch points.
            rev_args = ["rev-list", "--topo-order", "--reverse",
                        local_sha, "--not", f"--remotes={remote}"]
        rev_list = run_git(GIT, rev_args).stdout.strip()
        if rev_list:
            commits = rev_list.split("\n")
        else:
            commits = []

        if not remote_known_locally:
            # SHA reachability alone can't dedupe squash/rebase-merged commits
            # (they were rewritten into new SHAs upstream), so drop the ones
            # already integrated on the default branch and replant survivors on
            # its tip — otherwise we recreate them as duplicates.
            commits, parent_for_first, preserve_parents = drop_already_merged(
                GIT, client, remote, commits, parent_for_first, preserve_parents
            )

        if commits and not remote_sha:
            # Sanity check: every commit's parents must either be in this push
            # batch OR already exist on the remote. If we'd be pushing every
            # ancestor (no shared history known), bail with guidance rather
            # than silently creating an orphan branch.
            batch = set(commits)
            roots = []
            for c in commits:
                parent_line = run_git(
                    GIT, ["log", "-1", "--format=%P", c]
                ).stdout.strip()
                if not parent_line:
                    roots.append(c)
                    continue
                for p in parent_line.split():
                    if p not in batch:
                        # Parent is expected on the remote — that's fine.
                        pass
            if roots:
                print(f"Error: would push root commit(s) {', '.join(r[:7] for r in roots)} "
                      f"with no parent on {remote}. Fetch from {remote} first so the "
                      f"branch point is known locally, or push with --force to accept "
                      f"an orphan history.", file=sys.stderr)
                sys.exit(1)

    if not commits:
        print("No new commits to push")
        return

    print(f"Pushing {len(commits)} commit(s)...")

    sha_map = {}
    if remote_sha:
        sha_map[remote_sha] = remote_sha

    current_parent = parent_for_first
    for commit_sha in commits:
        tree_sha = run_git(GIT, ["rev-parse", f"{commit_sha}^{{tree}}"]).stdout.strip()
        # Byte-exact, trailing newline intact -- see commit_message(): a
        # .strip() here is what made this route recreate commits under new SHAs.
        msg = commit_message(GIT, commit_sha)

        # The REST API has no way to carry a commit signature, so a signed
        # commit necessarily comes out with a different SHA. Say so rather than
        # let the user discover it as mysterious history drift.
        header = run_git(GIT, ["cat-file", "commit", commit_sha],
                         text=False).stdout.split(b"\n\n", 1)[0]
        if b"\ngpgsig" in header:
            print(f"  Warning: {commit_sha[:7]} is signed; the API cannot carry "
                  "the signature, so the pushed commit gets a new SHA",
                  file=sys.stderr)
        author_name = run_git(GIT, ["log", "-1", "--format=%an", commit_sha]).stdout.strip()
        author_email = run_git(GIT, ["log", "-1", "--format=%ae", commit_sha]).stdout.strip()
        author_date = run_git(GIT, ["log", "-1", "--format=%aI", commit_sha]).stdout.strip()
        committer_name = run_git(GIT, ["log", "-1", "--format=%cn", commit_sha]).stdout.strip()
        committer_email = run_git(GIT, ["log", "-1", "--format=%ce", commit_sha]).stdout.strip()
        committer_date = run_git(GIT, ["log", "-1", "--format=%cI", commit_sha]).stdout.strip()

        # Use the first parent's tree as an incremental base when possible.
        # Its content (hence tree SHA) is identical on the remote — the parent
        # is either the remote branch point or a commit we just pushed — so
        # upload_tree only has to send the blobs that actually changed.
        orig_parents = run_git(GIT, ["log", "-1", "--format=%P", commit_sha]).stdout.strip().split()
        base_tree_sha = None
        if orig_parents:
            try:
                base_tree_sha = run_git(
                    GIT, ["rev-parse", f"{orig_parents[0]}^{{tree}}"]
                ).stdout.strip()
            except subprocess.CalledProcessError:
                base_tree_sha = None

        print(f"  Uploading tree for {commit_sha[:7]}...")
        new_tree_sha = client.upload_tree(tree_sha, base_tree_sha)

        if preserve_parents:
            parents = [sha_map.get(p, p) for p in orig_parents]
        else:
            parents = [current_parent] if current_parent else []

        commit_data = {
            "message": msg,
            "tree": new_tree_sha,
            "parents": parents,
            "author": {"name": author_name, "email": author_email, "date": author_date},
            "committer": {"name": committer_name, "email": committer_email, "date": committer_date},
        }

        commit_resp = client.api_request("POST", "git/commits", commit_data)
        new_sha = commit_resp["sha"]
        sha_map[commit_sha] = new_sha
        current_parent = new_sha
        print(f"  Created commit {new_sha[:7]}"
              + (f" (parents: {', '.join(p[:7] for p in parents)})" if len(parents) > 1 else ""))

    if branch_exists_remote:
        # Concurrency guard: re-read the ref right before moving it. If someone
        # else advanced the branch while we were uploading objects, our push
        # strategy (and parent chain) was computed against a stale tip — bail
        # rather than clobber their work. A real force push (-f) skips this.
        if not (force or needs_force):
            try:
                # 404 = the branch was deleted under us; nothing to clobber, so
                # treat it as "unchanged" quietly. Any other status is NOT
                # expected: it still prints, even though we degrade to the
                # pre-upload SHA rather than abort the push.
                current = client.api_request("GET", f"git/refs/heads/{branch}",
                                             quiet_codes=(404,))
                latest_remote_sha = current.get("object", {}).get("sha", "")
            except urllib.error.HTTPError:
                latest_remote_sha = remote_sha
            if latest_remote_sha and latest_remote_sha != remote_sha:
                print(f"Error: {branch} on {remote} moved from {remote_sha[:7]} to "
                      f"{latest_remote_sha[:7]} while pushing. Fetch and retry, or "
                      f"push with --force to override.", file=sys.stderr)
                sys.exit(1)
        client.api_request("PATCH", f"git/refs/heads/{branch}",
                    {"sha": current_parent, "force": force or needs_force})
    else:
        client.api_request("POST", "git/refs",
                    {"ref": f"refs/heads/{branch}", "sha": current_parent})

    print(f"Pushed {branch} → {current_parent[:7]}")

if __name__ == "__main__":
    main()
